Screen {
    layout: horizontal;
}

#left-column {
    layout: vertical;
    width: 28;
    height: 100%;
    overflow-y: auto;
}

#status {
    border: solid white;
    width: 100%;
    height: auto;
    padding-left: 1;
}

#files {
    border: solid white;
    width: 100%;
    height: 10;
    overflow-y: auto;
}

#branches {
    border: solid white;
    width: 100%;
    height: auto;
}

#commits {
    border: solid white;
    width: 100%;
    height: auto;
}
#stash {
    border: solid white;
    width: 100%;
    height: auto;
}
#right-column {
    layout: vertical;
    width: 1fr;
    height: 100%;
}

#diff {
    border: solid white;
    width: 100%;
    height: 1fr;
    overflow-y: auto;
}

#conflicts {
    border: solid red;
    width: 100%;
    height: auto;
    display: none;
}

#command-log {
    border: solid white;
    width: 100%;
    height: 8;
    overflow-y: auto;
}
CommitModal {
    align: center middle;
    background: $background 60%;
}

#commit-modal-box {
    width: 50;
    height: auto;
    border: solid white;
    padding: 1 2;
    background: $surface;
}
CommandPaletteModal, BranchInputModal {
    align: center middle;
    background: $background 60%;
}

#palette-box, #branch-input-box {
    width: 50;
    height: auto;
    border: solid white;
    padding: 1 2;
    background: $surface;
}