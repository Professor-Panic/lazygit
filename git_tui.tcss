Screen {
    layout: horizontal;
}

#left-column {
    layout: vertical;
    width: 30;
    height: 100%;
    overflow-y: auto;
}

#status {
    border: solid white;
    width: 100%;
    height: auto;
    padding-left: 1;
}

#files {
    border: solid white;
    width: 100%;
    height: 10;
    overflow-y: auto;
}

#branches {
    border: solid white;
    width: 100%;
    height: 10;
    overflow-y: auto;
}

#commits {
    border: solid white;
    width: 100%;
    height: 10;
    overflow-y: auto;
}

#stash {
    border: solid white;
    width: 100%;
    height: auto;
}

#right-column {
    layout: vertical;
    width: 1fr;
    height: 100%;
}

#diff {
    border: solid white;
    width: 100%;
    height: 1fr;
    overflow-y: auto;
}

#conflicts {
    border: solid red;
    width: 100%;
    height: auto;
    display: none;
}

#command-log {
    border: solid white;
    width: 100%;
    height: 1fr;
    overflow-y: auto;
}

#log-output {
    height: 1fr;
    width: 100%;
}

#command-input {
    height: 3;
    width: 100%;
}

CommitModal {
    align: center middle;
    background: $background 60%;
}

#commit-modal-box {
    width: 50;
    height: auto;
    border: solid white;
    padding: 1 2;
    background: $surface;
}

TodoModal {
    align: center middle;
    background: $background 60%;
}

#todo-modal-box {
    width: 50;
    height: auto;
    border: solid white;
    padding: 1 2;
    background: $surface;
}

CommandPaletteModal, BranchInputModal {
    align: center middle;
    background: $background 60%;
}

#palette-box, #branch-input-box {
    width: 50;
    height: auto;
    border: solid white;
    padding: 1 2;
    background: $surface;
}

/* ---------------- Sprint board ---------------- */
/* ---------------- Sprint board ---------------- */

SprintBoardModal {
    align: center middle;
    background: $background 60%;
}

#sprint-board-box {
    width: 90%;
    height: 80%;
    border: solid white;
    padding: 1 2;
    background: $surface;
    layout: vertical;
}

#sprint-title {
    width: 100%;
    height: auto;
    padding-bottom: 1;
    text-style: bold;
}

/* Horizontal scrolling container for columns */
#board-columns {
    layout: horizontal;
    width: 100%;
    height: 1fr;
    overflow-x: auto;
    overflow-y: hidden;
    padding-bottom: 0;
    align: left top;   /* horizontal left, vertical top */
}

/* Columns are all equal width (set dynamically in Python) and fill height */
.sprint-column {
    layout: vertical;
    width: 50;             /* fallback, overridden in refresh_board */
    min-width: 25;
    height: 1fr;           /* fill parent height */
    border: solid white;
    margin-right: 1;
    padding: 0 1;
    overflow-y: auto;      /* vertical scroll inside column if tasks overflow */
}

.sprint-column:focus-within {
    border: solid $accent;
}

.column-header {
    width: 100%;
    height: auto;
    padding: 0;
    background: $panel;
    text-style: bold;
    text-align: center;
}

.sprint-column ListView {
    width: 100%;
    height: 1fr;           /* take remaining column height */
    min-height: 5;
    overflow-y: auto;      /* scroll tasks vertically */
    border: none;
}

#sprint-actions {
    width: 100%;
    height: 3;
    align: right middle;
    padding-top: 1;
}

#sprint-actions Button {
    margin-left: 1;
}

#help-popup {
    width: 100%;
    height: auto;
    max-height: 60%;
    border: solid $accent;
    background: $surface;
    padding: 1;
    margin-bottom: 1;
    overflow-y: auto;
    display: none;
}