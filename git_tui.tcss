Screen {
    layout: horizontal;
}

#left-column {
    layout: vertical;
    width: 28;
    height: 100%;
    overflow-y: auto;
}

#status {
    border: solid white;
    width: 100%;
    height: auto;
    padding-left: 1;
}

#files {
    border: solid white;
    width: 100%;
    height: 10;
    overflow-y: auto;
}

#branches {
    border: solid white;
    width: 100%;
    height: auto;
}

#commits {
    border: solid white;
    width: 100%;
    height: auto;
}

#right-column {
    layout: vertical;
    width: 1fr;
    height: 100%;
}

#diff {
    border: solid white;
    width: 100%;
    height: 1fr;
}

#command-log {
    border: solid white;
    width: 100%;
    height: 8;
    overflow-y: auto;
}